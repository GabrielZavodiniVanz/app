{
  "staticSite": {
    "buildCommand": "npm run build",
    "publishPath": "dist",
    "headers": [
      {
        "source": "/*",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options", 
            "value": "nosniff"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/*",
        "destination": "/index.html"
      }
    ]
  }
}
