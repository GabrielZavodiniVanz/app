{
  "services": [
    {
      "type": "web",
      "name": "backend",
      "env": "node",
      "buildCommand": "cd backend && npm install",
      "startCommand": "cd backend && npm start"
    },
    {
      "type": "static",
      "name": "frontend", 
      "buildCommand": "cd frontend && npm install && npm run build",
      "staticPublishPath": "frontend/dist",
      "headers": [
        {
          "source": "/*",
          "headers": [
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            }
          ]
        }
      ],
      "routes": [
        {
          "type": "rewrite",
          "source": "/*",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
